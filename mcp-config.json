{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-server-config.json",
  "name": "stack-perfeita-mcp",
  "version": "5.0.0",
  "description": "MCP server for code discipline with Karpathy anti-slop, token economy, and modular architecture enforcement.",
  "mcpServers": {
    "stack-perfeita": {
      "command": "node",
      "args": ["src/index.js", "--project-root", "."],
      "env": {
        "NODE_ENV": "production"
      },
      "description": "Stack Perfeita MCP — automatic activation on session start"
    }
  },
  "autoActivation": {
    "enabled": true,
    "tools": [
      "activate_project",
      "doctor_runtime_setup",
      "get_rules_bundle",
      "shrink_stats",
      "profile_status"
    ],
    "description": "These tools are called automatically at session start"
  },
  "tokenEconomy": {
    "enabled": true,
    "profile": "core",
    "tools": [
      "shrink_text",
      "shrink_tool_descriptions",
      "shrink_stats",
      "profile_select",
      "profile_status",
      "profile_filter_tools",
      "smart_cmd",
      "smart_cmd_batch",
      "compress_memory_file",
      "compress_memory_batch",
      "compress_memory_preview"
    ],
    "autoCall": {
      "onSessionStart": ["shrink_stats", "profile_status"],
      "onToolCall": ["shrink_tool_descriptions"],
      "onCodeOutput": ["shrink_text"],
      "description": "Token economy tools called automatically to minimize token consumption"
    }
  },
  "karpathyGuidelines": {
    "enabled": true,
    "rules": [
      "18-karpathy-guidelines.md",
      "19-fullstack-architecture.md"
    ],
    "autoLoad": true,
    "description": "Karpathy anti-slop and modular architecture rules loaded automatically"
  },
  "hooks": {
    "preToolCall": {
      "enabled": true,
      "validation": "karpathy-hooks",
      "description": "Validates Karpathy guidelines before each tool call"
    },
    "tokenEconomy": {
      "enabled": true,
      "compressDescriptions": true,
      "filterByProfile": true,
      "smartCmdForShell": true,
      "description": "Token economy hooks applied automatically"
    }
  }
}
