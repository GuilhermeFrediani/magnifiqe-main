{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magnifiqe.dev/schemas/policy-taxonomy.json",
  "title": "Policy Taxonomy",
  "description": "Schema for categorized policy definitions with severity levels",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "display_name", "definition", "severity", "examples"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 2,
            "description": "Machine-readable category identifier (kebab-case)"
          },
          "display_name": {
            "type": "string",
            "minLength": 2,
            "description": "Human-readable category name"
          },
          "definition": {
            "type": "string",
            "minLength": 20,
            "description": "Clear definition of what this category covers"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error", "critical"],
            "description": "Default severity level for policies in this category"
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Example policies that fall into this category"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of policy categories"
    }
  },
  "additionalProperties": false
}
