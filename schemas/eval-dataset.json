{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magnifiqe.dev/schemas/eval-dataset.json",
  "title": "Evaluation Dataset",
  "description": "Schema for RAG evaluation dataset with test samples",
  "type": "object",
  "required": ["samples"],
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "ground_truth", "contexts", "metadata"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for the sample"
          },
          "question": {
            "type": "string",
            "minLength": 5,
            "description": "The question to evaluate"
          },
          "ground_truth": {
            "type": "string",
            "minLength": 1,
            "description": "Expected correct answer"
          },
          "contexts": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Context documents for retrieval"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "difficulty": {
                "type": "string",
                "enum": ["easy", "medium", "hard"],
                "description": "Difficulty level"
              },
              "category": {
                "type": "string",
                "description": "Topic category"
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Tags for filtering"
              }
            },
            "description": "Optional metadata about the sample"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of evaluation samples"
    }
  },
  "additionalProperties": false
}
